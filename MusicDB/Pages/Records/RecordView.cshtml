@page "{id:int}"
@model MusicDB.Pages.Records.RecordViewModel

@{
    ViewData["Title"] = (Model.Record.Name ?? "Record") + " — View";
    var record  = Model.Record;
    var discs   = Model.Discs;
}

<style>
/* ── RecordView page-scoped overrides ──────────────────────── */

/* Hero banner */
.rv-hero {
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 55%, #24243e 100%);
    border-radius: 16px;
    padding: 2.5rem 2.5rem 2rem;
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 8px 40px rgba(15, 12, 41, 0.45);
    position: relative;
    overflow: hidden;
}

/* subtle animated shimmer on the hero */
.rv-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg,
        rgba(255,255,255,0) 30%,
        rgba(255,255,255,0.04) 50%,
        rgba(255,255,255,0) 70%);
    background-size: 200% 100%;
    animation: shimmer 4s linear infinite;
    pointer-events: none;
}

@@keyframes shimmer {
    from { background-position: 200% 0; }
    to   { background-position: -200% 0; }
}

.rv-disc-icon {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    box-shadow: 0 0 0 4px rgba(102,126,234,0.4), 0 8px 24px rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    flex-shrink: 0;
    animation: spin-slow 18s linear infinite;
}

@@keyframes spin-slow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

.rv-hero-text { flex: 1; min-width: 0; }

.rv-artist-name {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #a78bfa;
    margin-bottom: 0.35rem;
}

.rv-artist-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
}
.rv-artist-name a:hover { color: #c4b5fd; text-decoration: underline; }

.rv-record-title {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    word-break: break-word;
}

.rv-record-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.55);
    font-style: italic;
    margin-bottom: 1rem;
}

/* pill badges row */
.rv-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
}

.rv-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    backdrop-filter: blur(6px);
}

.rv-badge-year   { background: rgba(102,126,234,0.25); color: #c4b5fd; border: 1px solid rgba(102,126,234,0.4); }
.rv-badge-discs  { background: rgba(16,185,129,0.2);   color: #6ee7b7; border: 1px solid rgba(16,185,129,0.35); }
.rv-badge-field  { background: rgba(245,158,11,0.2);   color: #fcd34d; border: 1px solid rgba(245,158,11,0.35); }
.rv-badge-length { background: rgba(239,68,68,0.2);    color: #fca5a5; border: 1px solid rgba(239,68,68,0.35); }

/* ── Meta info strip below hero ─────────────────────────── */
.rv-meta-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: #e9ecef;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
}

.rv-meta-cell {
    background: #fff;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.rv-meta-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
}

.rv-meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a2e;
}

.rv-meta-value.empty {
    color: #d1d5db;
    font-style: italic;
    font-weight: 400;
}

/* ── Disc nav tabs ──────────────────────────────────────── */
.rv-disc-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.rv-disc-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: #f3f0ff;
    color: #5b21b6;
    border: 1.5px solid #ddd6fe;
    transition: background 0.18s, color 0.18s, transform 0.12s, box-shadow 0.18s;
}

.rv-disc-tab:hover {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(102,126,234,0.35);
    text-decoration: none;
}

/* ── Disc section ───────────────────────────────────────── */
.rv-disc-section {
    margin-bottom: 2.5rem;
    scroll-margin-top: 80px;
}

.rv-disc-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid #ede9fe;
    margin-bottom: 1rem;
}

.rv-disc-number {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 800;
    flex-shrink: 0;
}

.rv-disc-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #4f46e5;
    margin: 0;
}

.rv-disc-subtitle {
    font-size: 0.85rem;
    color: #9ca3af;
    font-style: italic;
    margin-left: 0.25rem;
}

/* ── Tracks table ───────────────────────────────────────── */
.rv-tracks-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
    overflow: hidden;
}

.rv-tracks-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
}

.rv-tracks-table thead {
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: #fff;
}

.rv-tracks-table thead th {
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    border: none;
}

.rv-tracks-table tbody tr {
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.14s;
}

.rv-tracks-table tbody tr:last-child { border-bottom: none; }
.rv-tracks-table tbody tr:hover { background: #f5f3ff; }
.rv-tracks-table tbody tr:nth-child(even) { background: #fafafa; }
.rv-tracks-table tbody tr:nth-child(even):hover { background: #f5f3ff; }

.rv-tracks-table td { padding: 0.65rem 1rem; vertical-align: middle; }

.rv-td-num     { width: 52px; text-align: center; font-weight: 700; color: #7c3aed; }
.rv-td-name    { color: #1a1a2e; }
.rv-td-length  { color: #6b7280; white-space: nowrap; width: 90px; }
.rv-td-media   { color: #9ca3af; white-space: nowrap; width: 80px; font-size: 0.8rem; }
.rv-td-actions { white-space: nowrap; text-align: right; width: 180px; }

.rv-disc-footer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #9ca3af;
    font-weight: 600;
    padding: 0.5rem 0.25rem 0;
}

/* ── Page action buttons ────────────────────────────────── */
.rv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
}

/* ── Responsive ─────────────────────────────────────────── */
@@media (max-width: 640px) {
    .rv-hero {
        flex-direction: column;
        padding: 1.5rem 1.25rem 1.25rem;
        gap: 1.25rem;
    }

    .rv-disc-icon { width: 68px; height: 68px; font-size: 1.8rem; }

    .rv-tracks-table thead th:nth-child(4),
    .rv-tracks-table td:nth-child(4) { display: none; }

    .rv-td-actions { width: auto; }
}

@@media (min-width: 641px) and (max-width: 900px) {
    .rv-hero { padding: 2rem 1.75rem 1.75rem; }
}
</style>

<div class="rv-hero">
    <div class="rv-disc-icon">💿</div>
    <div class="rv-hero-text">
        <div class="rv-artist-name">
            <a asp-page="/Artists/ArtistSearch" asp-route-SelectedArtistId="@record.ArtistId">
                @(record.Artist?.Name ?? "Unknown Artist")
            </a>
        </div>
        <h1 class="rv-record-title">@(record.Name ?? "Unknown Record")</h1>
        @if (!string.IsNullOrWhiteSpace(record.SubTitle))
        {
            <div class="rv-record-subtitle">@record.SubTitle</div>
        }
        <div class="rv-badges">
            @if (record.Recorded.HasValue)
            {
                <span class="rv-badge rv-badge-year">🎙️ @record.Recorded</span>
            }
            @if (record.Discs.HasValue)
            {
                <span class="rv-badge rv-badge-discs">💿 @record.Discs @(record.Discs == 1 ? "Disc" : "Discs")</span>
            }
            @if (!string.IsNullOrWhiteSpace(record.Field))
            {
                <span class="rv-badge rv-badge-field">🎸 @record.Field</span>
            }
            @if (!string.IsNullOrWhiteSpace(record.Length))
            {
                <span class="rv-badge rv-badge-length">⏱️ @record.Length</span>
            }
        </div>
    </div>
</div>

@* ── Meta info strip ── *@
<div class="rv-meta-strip">
    <div class="rv-meta-cell">
        <span class="rv-meta-label">Artist</span>
        <span class="rv-meta-value">@(record.Artist?.Name ?? "—")</span>
    </div>
    <div class="rv-meta-cell">
        <span class="rv-meta-label">Recorded</span>
        <span class="rv-meta-value @(record.Recorded == null ? "empty" : "")">
            @(record.Recorded?.ToString() ?? "—")
        </span>
    </div>
    <div class="rv-meta-cell">
        <span class="rv-meta-label">Discs</span>
        <span class="rv-meta-value @(record.Discs == null ? "empty" : "")">
            @(record.Discs?.ToString() ?? "—")
        </span>
    </div>
    <div class="rv-meta-cell">
        <span class="rv-meta-label">Field</span>
        <span class="rv-meta-value @(string.IsNullOrWhiteSpace(record.Field) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(record.Field) ? "—" : record.Field)
        </span>
    </div>
    <div class="rv-meta-cell">
        <span class="rv-meta-label">Length</span>
        <span class="rv-meta-value @(string.IsNullOrWhiteSpace(record.Length) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(record.Length) ? "—" : record.Length)
        </span>
    </div>
</div>

@* ── Page actions ── *@
<div class="rv-actions">
    <a asp-page="./Edit" asp-route-id="@record.RecordId" class="btn-action btn-edit">✏️ Edit</a>
    <a asp-page="./Details" asp-route-id="@record.RecordId" class="btn-action btn-back">📋 Details</a>
    <a asp-page="./Index" class="btn-action btn-back">← Back to Records</a>
</div>

@* ── Disc navigation links ── *@
@if (discs.Count > 1)
{
    <div class="rv-disc-nav">
        @foreach (var d in discs)
        {
            <a href="#disc-@d.DiscId" class="rv-disc-tab">
                💿 @(string.IsNullOrWhiteSpace(d.Name) ? $"Disc {d.DiscNumber}" : d.Name)
            </a>
        }
    </div>
}

@* ── Discs & Tracks ── *@
@if (discs.Count == 0)
{
    <div class="alert alert-info py-4 text-center">
        <span>ℹ️ No discs or tracks found for this record.</span>
    </div>
}
else
{
    foreach (var disc in discs)
    {
        <div class="rv-disc-section" id="disc-@disc.DiscId">
            <div class="rv-disc-header">
                <div class="rv-disc-number">@disc.DiscNumber</div>
                <h2 class="rv-disc-title">
                    @(string.IsNullOrWhiteSpace(disc.Name) ? $"Disc {disc.DiscNumber}" : disc.Name)
                    @if (!string.IsNullOrWhiteSpace(disc.SubTitle))
                    {
                        <span class="rv-disc-subtitle">— @disc.SubTitle</span>
                    }
                </h2>
            </div>

            <div class="rv-tracks-card">
                <table class="rv-tracks-table">
                    <thead>
                        <tr>
                            <th class="rv-td-num">#</th>
                            <th>Track Name</th>
                            <th>Length</th>
                            <th>Media</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (disc.Tracks.Any())
                        {
                            foreach (var track in disc.Tracks)
                            {
                                <tr>
                                    <td class="rv-td-num">@track.Number</td>
                                    <td class="rv-td-name">@track.Name</td>
                                    <td class="rv-td-length">@track.Length</td>
                                    <td class="rv-td-media">@track.Media</td>
                                    <td class="rv-td-actions">
                                        <a asp-page="/Tracks/Edit"    asp-route-id="@track.TrackId" class="action-link action-edit">Edit</a>
                                        <a asp-page="/Tracks/Details" asp-route-id="@track.TrackId" class="action-link action-details">Details</a>
                                        <a asp-page="/Tracks/Delete"  asp-route-id="@track.TrackId" class="action-link action-delete">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">No tracks found on this disc.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrWhiteSpace(disc.Length))
            {
                <div class="rv-disc-footer">
                    <span>⏱️</span>
                    <span>Disc length:</span>
                    <span style="color:#1a1a2e;">@disc.Length</span>
                </div>
            }
        </div>
    }
}
