@page "{id:int?}"
@model MusicDB.Pages.Tracks.DetailsModel

@{
    var track = Model.Track;
    var record = Model.Record;
    var artist = record?.Artist;
    var artistName = track.Artist ?? artist?.Name ?? "Unknown Artist";
    var trackTitle = track.Title ?? track.Name ?? "Track Details";
    ViewData["Title"] = $"{trackTitle} — Details";

    string initial = !string.IsNullOrWhiteSpace(track.Title) 
        ? track.Title[0].ToString().ToUpper() 
        : (!string.IsNullOrWhiteSpace(track.Name) ? track.Name[0].ToString().ToUpper() : "♪");
}

<link rel="stylesheet" href="~/css/track-details.css" asp-append-version="true" />

@* ── Hero Banner ── *@
<div class="td-hero">
    <div class="td-avatar-icon">@initial</div>
    <div class="td-hero-text">
        <div class="td-breadcrumb">
            @if (artist != null)
            {
                <a asp-page="/Artists/ArtistSearch" asp-route-SelectedArtistId="@artist.ArtistId">@artist.Name</a>
                <span>›</span>
            }
            @if (record != null)
            {
                <a asp-page="/Records/RecordView" asp-route-id="@record.RecordId">@(record.Name ?? "Record")</a>
                <span>›</span>
            }
            <span>Track #@(track.Number?.ToString() ?? "—")</span>
        </div>

        <h1 class="td-track-title">@(track.Title ?? track.Name ?? "Unnamed Track")</h1>

        <div class="td-track-subtitle">
            <span>By <strong>@artistName</strong></span>
            @if (record != null)
            {
                <span>• From album <a asp-page="/Records/RecordView" asp-route-id="@record.RecordId">@(record.Name ?? "Unknown Album")</a></span>
            }
            else if (!string.IsNullOrWhiteSpace(track.Album))
            {
                <span>• From album <strong>@track.Album</strong></span>
            }
        </div>

        <div class="td-badges">
            @if (track.Recorded.HasValue)
            {
                <span class="td-badge td-badge-year">🎙️ @track.Recorded</span>
            }
            @if (track.Number.HasValue)
            {
                <span class="td-badge td-badge-disc">🎵 Track @track.Number</span>
            }
            @if (track.DiscNumber.HasValue)
            {
                <span class="td-badge td-badge-disc">💿 Disc @track.DiscNumber</span>
            }
            @if (!string.IsNullOrWhiteSpace(track.Length))
            {
                <span class="td-badge td-badge-length">⏱️ @track.Length</span>
            }
            @if (!string.IsNullOrWhiteSpace(track.Media))
            {
                <span class="td-badge td-badge-media">🎚️ @track.Media</span>
            }
            @if (!string.IsNullOrWhiteSpace(track.Field))
            {
                <span class="td-badge td-badge-field">🎸 @track.Field</span>
            }
        </div>
    </div>
</div>

@* ── Quick Meta Info Strip ── *@
<div class="td-meta-strip">
    <div class="td-meta-cell">
        <span class="td-meta-label">Artist</span>
        <span class="td-meta-value">
            @if (artist != null)
            {
                <a asp-page="/Artists/ArtistSearch" asp-route-SelectedArtistId="@artist.ArtistId">@artistName</a>
            }
            else
            {
                @artistName
            }
        </span>
    </div>
    <div class="td-meta-cell">
        <span class="td-meta-label">Album / Record</span>
        <span class="td-meta-value @(record == null && string.IsNullOrWhiteSpace(track.Album) ? "empty" : "")">
            @if (record != null)
            {
                <a asp-page="/Records/RecordView" asp-route-id="@record.RecordId">@(record.Name ?? "—")</a>
            }
            else
            {
                @(track.Album ?? "—")
            }
        </span>
    </div>
    <div class="td-meta-cell">
        <span class="td-meta-label">Disc / Track</span>
        <span class="td-meta-value">
            Disc @(track.DiscNumber?.ToString() ?? "1") · #@(track.Number?.ToString() ?? "—")
        </span>
    </div>
    <div class="td-meta-cell">
        <span class="td-meta-label">Duration</span>
        <span class="td-meta-value @(track.Duration == null && string.IsNullOrWhiteSpace(track.Length) ? "empty" : "")">
            @(track.Duration?.ToString(@"hh\:mm\:ss") ?? track.Length ?? "—")
        </span>
    </div>
    <div class="td-meta-cell">
        <span class="td-meta-label">Media</span>
        <span class="td-meta-value @(string.IsNullOrWhiteSpace(track.Media) ? "empty" : "")">
            @(track.Media ?? "—")
        </span>
    </div>
</div>

@* ── Page Actions ── *@
<div class="td-actions">
    <a asp-page="./Edit" asp-route-id="@track.TrackId" class="btn-action btn-primary-action">✏️ Edit Track</a>
    @if (record != null)
    {
        <a asp-page="/Records/RecordView" asp-route-id="@record.RecordId" class="btn-action btn-back">💿 View Album</a>
    }
    @if (artist != null)
    {
        <a asp-page="/Artists/ArtistSearch" asp-route-SelectedArtistId="@artist.ArtistId" class="btn-action btn-back">👤 View Artist</a>
    }
    <a asp-page="./Delete" asp-route-id="@track.TrackId" class="btn-action btn-delete">🗑️ Delete</a>
    <a asp-page="./Index" class="btn-action btn-back">← Back to Tracks</a>
</div>

@* ── Detailed Two-Column Cards Grid ── *@
<div class="td-cards-grid">

    @* Card 1: Track & Release Details *@
    <div class="td-card">
        <div class="td-card-header">
            <span>🎼</span>
            <span>Track &amp; Release Info</span>
        </div>
        <div class="td-card-body">
            <div class="td-detail-list">
                <div class="td-detail-item">
                    <span class="td-item-label">Track Title</span>
                    <span class="td-item-value">@(track.Title ?? "—")</span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">File / Raw Name</span>
                    <span class="td-item-value">@(track.Name ?? "—")</span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Artist</span>
                    <span class="td-item-value">
                        @if (artist != null)
                        {
                            <a asp-page="/Artists/ArtistSearch" asp-route-SelectedArtistId="@artist.ArtistId">@artistName</a>
                        }
                        else
                        {
                            @artistName
                        }
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Album / Record</span>
                    <span class="td-item-value">
                        @if (record != null)
                        {
                            <a asp-page="/Records/RecordView" asp-route-id="@record.RecordId">@(record.Name ?? "—")</a>
                        }
                        else
                        {
                            @(track.Album ?? "—")
                        }
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Disc</span>
                    <span class="td-item-value">
                        @(track.Disc?.Name ?? $"Disc {track.DiscNumber ?? 1}")
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Track Number</span>
                    <span class="td-item-value">
                        <span class="td-pill-tag">#@(track.Number?.ToString() ?? "—")</span>
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Recorded Year</span>
                    <span class="td-item-value">@(track.Recorded?.ToString() ?? "—")</span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Field / Genre</span>
                    <span class="td-item-value">@(track.Field ?? "—")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(track.Folder))
                {
                    <div class="td-detail-item">
                        <span class="td-item-label">Folder</span>
                        <span class="td-item-value code-path" title="@track.Folder">@track.Folder</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Card 2: Audio & Technical Specs *@
    <div class="td-card">
        <div class="td-card-header">
            <span>🎛️</span>
            <span>Audio &amp; Technical Specs</span>
        </div>
        <div class="td-card-body">
            <div class="td-detail-list">
                <div class="td-detail-item">
                    <span class="td-item-label">Media Type</span>
                    <span class="td-item-value">
                        @if (!string.IsNullOrWhiteSpace(track.Media))
                        {
                            <span class="td-pill-tag">@track.Media</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Length</span>
                    <span class="td-item-value">@(track.Length ?? "—")</span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Duration</span>
                    <span class="td-item-value">@(track.Duration?.ToString(@"hh\:mm\:ss") ?? "—")</span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Bit Depth</span>
                    <span class="td-item-value">
                        @if (track.Bits.HasValue)
                        {
                            @($"{track.Bits}-bit")
                            @(track.Bits >= 24 ? " (Hi-Res)" : track.Bits == 16 ? " (CD Quality)" : "")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Bit Rate</span>
                    <span class="td-item-value">
                        @(track.BitRate.HasValue ? $"{track.BitRate} kbps" : "—")
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Sample Rate</span>
                    <span class="td-item-value">
                        @(track.AudioSampleRate.HasValue ? $"{track.AudioSampleRate:N0} Hz" : "—")
                    </span>
                </div>
                <div class="td-detail-item">
                    <span class="td-item-label">Channels</span>
                    <span class="td-item-value">
                        @if (track.AudioChannels.HasValue)
                        {
                            @($"{track.AudioChannels} {(track.AudioChannels == 2 ? "(Stereo)" : track.AudioChannels == 1 ? "(Mono)" : "(Multi-channel)")}")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

