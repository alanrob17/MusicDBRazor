@page "{id:int}"
@model MusicDB.Pages.Artists.ArtistViewModel

@{
    var artist  = Model.Artist;
    var records = Model.Records;

    ViewData["Title"] = (artist.Name ?? "Artist") + " — View";

    // Build initials for the avatar
    string initials = string.Concat(
        artist.FirstName?.Length > 0 ? artist.FirstName[0].ToString() : "",
        artist.LastName?.Length  > 0 ? artist.LastName[0].ToString()  : ""
    );
    if (initials.Length == 0)
        initials = artist.Name?.Length > 0 ? artist.Name[0].ToString().ToUpper() : "?";

    bool hasBio = !string.IsNullOrWhiteSpace(artist.Biography);
}

<link rel="stylesheet" href="~/css/artist-view.css" asp-append-version="true" />

@* ── HERO BANNER ── *@
<div class="av-hero">
    <div class="av-avatar">@initials</div>
    <div class="av-hero-text">
        <div class="av-name-label">Artist</div>
        <h1 class="av-artist-name">@(artist.Name ?? "Unknown Artist")</h1>

        @if (!string.IsNullOrWhiteSpace(artist.FirstName) || !string.IsNullOrWhiteSpace(artist.LastName))
        {
            <div class="av-full-name">@artist.FirstName @artist.LastName</div>
        }

        <div class="av-badges">
            <span class="av-badge av-badge-records">
                💿 @Model.RecordCount @(Model.RecordCount == 1 ? "Record" : "Records")
            </span>
            @if (hasBio)
            {
                <span class="av-badge av-badge-bio">📖 Biography available</span>
            }
        </div>

    </div>
</div>

@* ── META STRIP ── *@
<div class="av-meta-strip">
    <div class="av-meta-cell">
        <span class="av-meta-label">Name</span>
        <span class="av-meta-value">@(artist.Name ?? "—")</span>
    </div>
    <div class="av-meta-cell">
        <span class="av-meta-label">First Name</span>
        <span class="av-meta-value @(string.IsNullOrWhiteSpace(artist.FirstName) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(artist.FirstName) ? "—" : artist.FirstName)
        </span>
    </div>
    <div class="av-meta-cell">
        <span class="av-meta-label">Last Name</span>
        <span class="av-meta-value @(string.IsNullOrWhiteSpace(artist.LastName) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(artist.LastName) ? "—" : artist.LastName)
        </span>
    </div>
    <div class="av-meta-cell">
        <span class="av-meta-label">Total Records</span>
        <span class="av-meta-value">@Model.RecordCount</span>
    </div>
    <div class="av-meta-cell">
        <span class="av-meta-label">Folder</span>
        <span class="av-meta-value @(string.IsNullOrWhiteSpace(artist.Folder) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(artist.Folder) ? "—" : artist.Folder)
        </span>
    </div>
</div>

@* ── ACTION BUTTONS ── *@
<div class="av-actions">
    <a asp-page="./Edit" asp-route-id="@artist.ArtistId" class="btn-action btn-primary-action">✏️ Edit</a>
    <a asp-page="./Details" asp-route-id="@artist.ArtistId" class="btn-action btn-back">📋 Details</a>
    <a asp-page="./Index" class="btn-action btn-back">← Back to Artists</a>
</div>

@* ── BIOGRAPHY TOGGLE + PANEL ── *@
@if (hasBio)
{
    <button type="button" class="av-bio-toggle" id="bioToggle" aria-expanded="false" aria-controls="biographyPanel">
        📖 Show Biography
        <span class="av-chevron" aria-hidden="true">▼</span>
    </button>
    <div class="av-bio-panel" id="biographyPanel" role="region" aria-label="Artist Biography">
        <div class="av-bio-panel-header">📖 Biography</div>
        @Html.Raw(artist.Biography)
    </div>
}

@* ── RECORDS TABLE ── *@
<div class="av-records-header">
    <h2 class="av-records-title">
        💿 Discography
    </h2>
    <span class="av-records-count">@Model.RecordCount @(Model.RecordCount == 1 ? "album" : "albums")</span>
</div>

@if (records.Any())
{
    <div class="av-records-card">
        <table class="av-records-table">
            <thead>
                <tr>
                    <th class="av-td-year">Year</th>
                    <th>Record Name</th>
                    <th class="av-td-discs">Discs</th>
                    <th class="av-td-length">Length</th>
                    <th class="av-td-field">Field</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rec in records)
                {
                    <tr>
                        <td class="av-td-year">@rec.Recorded</td>
                        <td class="av-td-name">
                            <a asp-page="/Records/RecordView" asp-route-id="@rec.RecordId">@rec.Name</a>
                        </td>
                        <td class="av-td-discs">@rec.Discs</td>
                        <td class="av-td-length">@rec.Length</td>
                        <td class="av-td-field">@rec.Field</td>
                        <td class="av-td-actions">
                            <a asp-page="/Records/RecordView" asp-route-id="@rec.RecordId" class="action-link action-details">View</a>
                            <a asp-page="/Records/Edit"       asp-route-id="@rec.RecordId" class="action-link action-edit">Edit</a>
                            <a asp-page="/Records/GetRecord"  asp-route-recordId="@rec.RecordId" class="action-link action-details">Tracks</a>
                            <a asp-page="/Records/Delete"     asp-route-id="@rec.RecordId" class="action-link action-delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info py-4 text-center">
        <span>ℹ️ No records found for this artist.</span>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const toggle = document.getElementById('bioToggle');
            const panel  = document.getElementById('biographyPanel');
            if (!toggle || !panel) return;

            toggle.addEventListener('click', function () {
                const isOpen = panel.classList.toggle('open');
                toggle.classList.toggle('open', isOpen);
                toggle.setAttribute('aria-expanded', isOpen);
                toggle.childNodes[0].textContent = isOpen ? '📖 Hide Biography ' : '📖 Show Biography ';
            });
        })();
    </script>
}
